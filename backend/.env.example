# Copiez ce fichier en « .env » (ignoré par git) et renseignez vos valeurs. Ne committez JAMAIS de vraie clé.

# --- Obligatoires -------------------------------------------------------------------------------------------------
GEMINI_API_KEY=
# Jeton GitHub (lecture/écriture des dépôts cibles, branches, PR)
GITHUB_TOKEN=
# Authentification des utilisateurs (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Base de données (SQLite local par défaut si absent) ----------------------------------------------------------
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base

# --- Modèles et limites de débit ----------------------------------------------------------------------------------
# GEMINI_MODEL=                 # force UN SEUL modèle pour tous les agents (repli si un modèle manque sur votre clé)
# GEMINI_MODEL_LIMITS={"gemini-3.8-flash": {"rpm": 10, "tpm": 250000, "rpd": 1500}}
# LLM_RATE_MARGIN=0.8           # part des plafonds réellement utilisée (0,1 à 1)

# --- Traces LangSmith (OpenTelemetry) : INACTIVES sans les deux premières lignes ------------------------------------
# ATTENTION : activer les traces envoie des données (durées, modèles, tokens, erreurs) à un service tiers.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # région UE : voir la documentation LangSmith
# LANGSMITH_PROJECT=myiacrew
# OTEL_CAPTURE_CONTENT=false    # true : envoie aussi la sortie de chaque agent (secrets masqués, 4000 caractères au plus)

# --- Exploitation -------------------------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# CREW_LOG_FILE=                # journal CrewAI complet (prompts et sorties) : diagnostic ponctuel seulement
# LOCAL_WORKSPACE_DIR=
